{
  "name": "repo-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RepoAtlas / 代码星图：DeepSeek Harness 的安全只读代码库分析插件核心。",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./harness": "./src/harness/plugin.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "demo": "node --experimental-strip-types examples/demo.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "node scripts/lint.mjs",
    "validate:openspec": "openspec validate repo-atlas-v1-readonly-mvp --strict --no-interactive"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
